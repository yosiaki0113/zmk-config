#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    /* アナログ入力を WASD キーイベントへ変換するリスナー定義 */
    joystick_listener: joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;

        /* X軸 (A / D) 判定 */
        x-axis {
            input-code = <0>; // X軸
            map-negative = <&kp A>; // 左（負の方向）
            map-positive = <&kp D>; // 右（正の方向）
        };

        /* Y軸 (W / S) 判定 */
        y-axis {
            input-code = <1>; // Y軸
            map-negative = <&kp W>; // 上（負の方向）
            map-positive = <&kp S>; // 下（正の方向）
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /* レイヤー 0 (通常入力) */
        default_layer {
            bindings = <
                &kp Q    &kp E    &kp R    &kp F    &kp SPACE    &kp N2    &kp N3    &mo 1
            >;
        };

        /* レイヤー 1 (機能拡張) */
        ble_layer {
            bindings = <
                &kp N7   &kp I    &none    &none    &none        &none     &none     &trans
            >;
        };
    };
};