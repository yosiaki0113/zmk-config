#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
/* アナログスティックの入力を WASD キーに変換するリスナー */
    joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;

        /* X軸 (A / D) の判定 */
        x-input {
            input-processors = <&zip_temp_pinnable>;
            bindings = <&kp A &kp D>;
        };

        /* Y軸 (W / S) の判定 */
        y-input {
            input-processors = <&zip_temp_pinnable>;
            bindings = <&kp W &kp S>;
        };
    };
    keymap {
        compatible = "zmk,keymap";

        // レイヤー 0 (通常入力)

        default_layer {
            bindings = <
&kp Q  &kp E  &kp R  &kp F  &kp SPACE  &kp N2  &kp N3  &mo 1
            >;
        };

        // レイヤー 1 (Bluetooth / バッテリー操作用)

        ble_layer {
            bindings = <
&kp N7  &kp I  &msc SCRL_UP  &none  &none  &none  &msc SCRL_DOWN  &trans
            >;
        };
    };
};
