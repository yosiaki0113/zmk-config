#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {

    joystick_listener {
        compatible = "zmk,input-listener";
        device = <&joystick>;

        x-input {
            input-processors = <&zip_temp_pinnable>;
            bindings = <&kp A &kp D>;
        };

        y-input {
            input-processors = <&zip_temp_pinnable>;
            bindings = <&kp W &kp S>;
        };
    };
    keymap {
        compatible = "zmk,keymap";


        default_layer {
            bindings = <
&kp Q  &kp E  &kp R  &kp F  &kp SPACE  &kp N2  &kp N3  &mo 1
            >;
        };


        ble_layer {
            bindings = <
&kp N7  &kp I  &msc SCRL_UP  &none  &none  &none  &msc SCRL_DOWN  &trans
            >;
        };
    };
};
